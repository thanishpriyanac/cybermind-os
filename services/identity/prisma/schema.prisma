generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// Core Domain
// ------------------------------------------------------

model Tenant {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String    @unique
  status               String    @default("ACTIVE")
  settings             Json?     // Identity and tenancy metadata
  subscriptionReference String?
  timezone             String?   @default("UTC")
  locale               String?   @default("en-US")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  createdBy            String?   @db.Uuid
  updatedBy            String?   @db.Uuid
  version              Int       @default(1)

  users      User[]
  roles      Role[]
  auditLogs  AuditLog[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  email        String
  passwordHash String?
  status       String    @default("ACTIVE")
  mfaState     String    @default("DISABLED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  version      Int       @default(1)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile       UserProfile?
  roles         UserRole[]
  sessions      Session[]
  mfaFactors    MFAFactor[]
  oauthAccounts OAuthAccount[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  firstName   String?
  lastName    String?
  avatar      String?
  department  String?
  jobTitle    String?
  phone       String?
  preferences Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  description String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  version     Int       @default(1)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  effect      String    @default("allow") // allow or deny
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roles       RolePermission[]

  @@unique([resource, action, effect])
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------
// Authentication & Advanced
// ------------------------------------------------------

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  tenantId         String    @db.Uuid
  deviceId         String?
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  geoLocation      String?
  lastActivity     DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model IdentityProvider {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @db.Uuid // null = Global IdP
  name         String
  type         String    // e.g., 'SAML', 'OIDC', 'GITHUB'
  issuer       String?
  clientId     String?
  clientSecret String?
  status       String    @default("ACTIVE")
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  oauthAccounts OAuthAccount[]

  @@index([tenantId])
  @@map("identity_providers")
}

model OAuthAccount {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  providerId   String    @db.Uuid
  providerUser String    // User ID from the external provider
  accessToken  String?
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerUser])
  @@map("oauth_accounts")
}

model MFAFactor {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  type         String    // e.g., 'TOTP', 'WEBAUTHN'
  secret       String?
  isVerified   Boolean   @default(false)
  status       String    @default("ACTIVE")
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

// ------------------------------------------------------
// Security & Governance
// ------------------------------------------------------

model LoginAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  email       String?
  ipAddress   String
  userAgent   String?
  isSuccess   Boolean
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([ipAddress])
  @@map("login_attempts")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isUsed    Boolean  @default(false)

  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isUsed    Boolean  @default(false)

  @@index([email])
  @@map("email_verification_tokens")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  tenantId      String   @db.Uuid
  action        String
  resource      String
  resourceId    String?  @db.Uuid
  before        Json?
  after         Json?
  correlationId String?
  traceId       String?
  timestamp     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@map("audit_logs")
}
