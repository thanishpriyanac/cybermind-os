// ─────────────────────────────────────────────────────────────────────────────
// CYBERMIND AI — Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("AI_DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── Provider & Model Registry ─────────────────────────────────────────────────

model ProviderModel {
  id               String   @id @default(uuid())
  provider         String   // 'openai' | 'anthropic' | 'ollama' | 'perplexity' | 'deepseek'
  modelKey         String   @unique // 'gpt-4o' | 'claude-3-5-sonnet-20241022' | 'llama3.1'
  displayName      String
  contextWindow    Int
  maxOutputTokens  Int
  costPerInput1k   Decimal  @db.Decimal(10, 6)
  costPerOutput1k  Decimal  @db.Decimal(10, 6)
  supportsStreaming Boolean  @default(true)
  supportsVision   Boolean  @default(false)
  isLocal          Boolean  @default(false)
  isActive         Boolean  @default(true)
  capabilities     String[] // ['code', 'security', 'reasoning', 'fast']
  createdAt        DateTime @default(now())
}

model EmbeddingModel {
  id        String   @id @default(uuid())
  name      String   @unique // 'text-embedding-3-small' | 'bge-m3'
  provider  String   // 'openai' | 'local'
  dimension Int      // 1536 | 1024 | 768
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── Conversations & Messages ──────────────────────────────────────────────────

model Conversation {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  title       String?
  modelKey    String
  systemPrompt String?
  totalTokens Int       @default(0)
  totalCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages    Message[]
  memories    ConversationMemory[]

  @@index([tenantId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           MessageRole  // USER | ASSISTANT | SYSTEM | TOOL
  content        String
  modelKey       String?
  provider       String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  latencyMs      Int          @default(0)
  costUsd        Decimal      @default(0) @db.Decimal(12, 6)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ── Semantic Memory (pgvector) ────────────────────────────────────────────────

model ConversationMemory {
  id             String                   @id @default(uuid())
  conversationId String
  tenantId       String
  content        String                   // summary or key entity extracted
  memoryType     String                   // 'SUMMARY' | 'ENTITY' | 'IOC' | 'FINDING'
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                 @default(now())

  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ── Knowledge Graph ───────────────────────────────────────────────────────────

model KnowledgeGraphNode {
  id         String   @id @default(uuid())
  tenantId   String   @default("GLOBAL")
  label      String   // 'APT29' | 'CVE-2024-3094' | 'CobaltStrike'
  nodeType   String   // 'THREAT_ACTOR' | 'CVE' | 'MALWARE' | 'MITRE_TECHNIQUE' | 'IOC' | 'CAMPAIGN'
  properties Json     @default("{}")
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outEdges   KnowledgeGraphEdge[] @relation("SourceNode")
  inEdges    KnowledgeGraphEdge[] @relation("TargetNode")

  @@index([nodeType])
  @@index([tenantId])
}

model KnowledgeGraphEdge {
  id           String             @id @default(uuid())
  sourceId     String
  targetId     String
  relationship String             // 'EXPLOITS' | 'TARGETS' | 'USES_MALWARE' | 'MITIGATES' | 'ATTRIBUTED_TO'
  weight       Float              @default(1.0)
  properties   Json               @default("{}")
  createdAt    DateTime           @default(now())

  sourceNode   KnowledgeGraphNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  targetNode   KnowledgeGraphNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationship])
}

// ── Knowledge Articles (CVE / CISA / ATT&CK) ─────────────────────────────────

model KnowledgeArticle {
  id          String   @id @default(uuid())
  source      String   // 'nvd' | 'cisa' | 'mitre_attack' | 'manual'
  externalId  String   @unique // 'CVE-2024-3094' | 'T1059.001'
  title       String
  summary     String
  content     String
  severity    String?
  tags        String[]
  embedding   Unsupported("vector(1536)")?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source])
}

// ── Dataset Curation Pipeline ─────────────────────────────────────────────────

model DatasetEntry {
  id               String   @id @default(uuid())
  promptText       String
  responseText     String
  providerUsed     String
  qualityScore     Int      @default(0) // 1–5
  isHumanVerified  Boolean  @default(false)
  piiRedacted      Boolean  @default(true)
  licenseCompliant Boolean  @default(true)
  tags             String[]
  createdAt        DateTime @default(now())
}

// ── Audit Log ─────────────────────────────────────────────────────────────────

model AiAuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  action       String   // 'QUERY' | 'FILE_UPLOAD' | 'KNOWLEDGE_SEARCH' | 'CONSENSUS'
  modelKey     String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  latencyMs    Int      @default(0)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}
