# App Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
ENCRYPTION_KEY=32_byte_aes_gcm_master_secret_key_here

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cybermind_db?schema=public&pgbouncer=true"

# Redis Queue & Event Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth & Security
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Cloudflare R2 (Object Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cybermind-artifacts
