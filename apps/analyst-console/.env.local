# ═══════════════════════════════════════════════════════════════════════════════
#  CYBERMIND Copilot — AI Provider Keys
#  Auto-fallback order: Gemini → OpenAI → Anthropic → Groq
#  Add at least ONE key. More keys = more resilience when limits are hit.
# ═══════════════════════════════════════════════════════════════════════════════

# 1️⃣  Google Gemini (Recommended — Free tier available)
#      Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2️⃣  OpenAI GPT-4o-mini (Fallback 1)
#      Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3️⃣  Anthropic Claude Haiku (Fallback 2)
#      Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 4️⃣  Groq LLaMA-3 70B (Fallback 3 — FREE, very fast)
#      Get key: https://console.groq.com/keys
GROQ_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#  Backend Gateway (optional — if running separate ai-gateway microservice)
# ═══════════════════════════════════════════════════════════════════════════════
# AI_GATEWAY_URL=http://localhost:3010/api/v1/ai
