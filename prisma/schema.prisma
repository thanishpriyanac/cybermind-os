datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  mfaSecret    String?
  mfaEnabled   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  isRevoked Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id           String   @id @default(uuid())
  provider     String   // e.g. 'openai', 'anthropic'
  keyName      String   // e.g. 'Production OpenAI Key'
  encryptedKey String   @db.Text
  encryptedDek String   @db.Text
  iv           String
  authTag      String
  keyVersion   Int      @default(1) // For master key rotation support
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   @default("VIEWER") // VIEWER, ANALYST, SENIOR_ANALYST, ADMIN
  createdAt DateTime @default(now())
}

model ProviderConfiguration {
  id                   String   @id @default(uuid())
  provider             String
  modelKey             String   @unique
  displayName          String
  contextWindow        Int
  maxOutputTokens      Int
  costPerInput1k       Decimal  @db.Decimal(10, 6)
  costPerOutput1k      Decimal  @db.Decimal(10, 6)
  supportsStreaming     Boolean  @default(true)
  supportsVision       Boolean  @default(false)
  supportsTools        Boolean  @default(false)
  supportsEmbedding    Boolean  @default(false)
  isLocal              Boolean  @default(false)
  isActive             Boolean  @default(true)
  healthStatus         String   @default("ONLINE") // ONLINE, OFFLINE, DEGRADED, CIRCUIT_OPEN
  lastSuccessAt        DateTime?
  lastFailureAt        DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ProviderHealthEvent {
  id             String   @id @default(uuid())
  provider       String
  modelKey       String
  previousStatus String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())
}

model Conversation {
  id             String             @id @default(uuid())
  tenantId       String             @default("default_tenant")
  title          String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  turns          ConversationTurn[]
  semanticMemory SemanticMemory[]
}

model ConversationTurn {
  id               String        @id @default(uuid())
  conversationId   String
  promptText       String
  mode             String        @default("SMART")
  consensusSummary String?
  createdAt        DateTime      @default(now())
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responses        AIResponse[]
}

model AIResponse {
  id               String           @id @default(uuid())
  turnId           String
  provider         String
  modelKey         String
  responseText     String           @db.Text
  status           String           @default("COMPLETED")
  latencyMs        Int
  costUsd          Decimal          @db.Decimal(10, 6)
  promptTokens     Int              @default(0)
  completionTokens Int              @default(0)
  createdAt        DateTime         @default(now())
  turn             ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
}

model CyberArticle {
  id                 String                 @id @default(uuid())
  title              String
  content            String                 @db.Text
  url                String                 @unique
  source             String                 // NVD, CISA, MITRE, RSS
  sourceType         String                 @default("RSS")
  publishedAt        DateTime
  cveRefs            String[]
  mitreTechniques    String[]
  affectedProducts   String[]
  riskLevel          String                 @default("INFO")
  confidenceScore    Float                  @default(1.0)
  isManuallyVerified Boolean                @default(false)
  documentHash       String?                @unique
  parserVersion      String?                @default("1.0")
  processingStatus   String                 @default("PENDING")
  extractionModel    String?
  extractionTime     DateTime?
  embedding          Unsupported("vector")?
  embeddingModel     String?
  embeddingVersion   String?
  tags               String[]
  firstSeen          DateTime               @default(now())
  lastVerified       DateTime               @default(now())
  expiresAt          DateTime?
  ingestedAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())
  
  // Note: PostgreSQL full-text search capability will be added via raw SQL migration or index, 
  // but we can add a searchable text field if needed. Prisma doesn't natively support TSVector.
  // We will run raw queries against `title` and `content`.
}

model KnowledgeGraphNode {
  id         String               @id @default(uuid())
  label      String               @unique
  nodeType   String
  properties Json?
  provenance Json                 @default("[]") // array of { source, confidence, lastUpdated, documentId, version }
  aiConfidence    Float           @default(1.0)
  humanConfidence Float?
  sourceConfidence Float          @default(1.0)
  
  isAlias         Boolean         @default(false)
  canonicalId     String?
  humanVerified   Boolean         @default(false)
  
  firstSeen  DateTime             @default(now())
  lastVerified DateTime           @default(now())
  expiresAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  outEdges   KnowledgeGraphEdge[] @relation("SourceNode")
  inEdges    KnowledgeGraphEdge[] @relation("TargetNode")
}

model KnowledgeGraphEdge {
  id           String             @id @default(uuid())
  sourceId     String
  targetId     String
  relationship String
  weight       Float              @default(1.0)
  createdAt    DateTime           @default(now())
  
  source       KnowledgeGraphNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target       KnowledgeGraphNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)
}

model RetrievalSession {
  id                 String   @id @default(uuid())
  query              String
  modelUsed          String?
  retrievalWeights   Json?
  retrievedDocIds    String[]
  graphDepth         Int      @default(1)
  executionTimeMs    Int      @default(0)
  aiAnswer           String?  @db.Text
  createdAt          DateTime @default(now())
}

model HumanReviewTask {
  id           String   @id @default(uuid())
  entityId     String
  entityType   String   // Node, Edge, Article
  reason       String
  priority     String   @default("LOW") // HIGH, MEDIUM, LOW
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, ESCALATED
  assignedTo   String?
  createdBy    String?
  reviewNotes  String?
  resolution   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

model SemanticMemory {
  id             String                 @id @default(uuid())
  conversationId String
  summaryText    String                 @db.Text
  embedding      Unsupported("vector")?
  createdAt      DateTime               @default(now())
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  details   Json?
  ipAddress String
  createdAt DateTime @default(now())
}

model PlatformMetric {
  id        String   @id @default(uuid())
  metricKey String   @unique
  value     Decimal  @db.Decimal(12, 6) @default(0)
  updatedAt DateTime @updatedAt
}

